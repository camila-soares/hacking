# Copie para .env dentro do diretório do bb-toolkit (mesmo nível do
# docker-compose.yml) e ajuste os valores. O deploy.sh gera o
# API_TOKEN automaticamente se este arquivo não existir ainda.

# Token de autenticação da API — obrigatório em produção.
# Gerar com: openssl rand -hex 32
API_TOKEN=

# Necessário apenas se usar o profile "ngrok" (docker compose --profile ngrok up).
# Não recomendado em produção com VPS — use o Caddyfile com HTTPS em vez disso.
NGROK_AUTHTOKEN=
